# ==============================================================================
# JARVIS AI Assistant — Git Ignore Configuration
# ==============================================================================

# ── Secrets & Credentials (NEVER COMMIT) ──────────────────────────────────────
config/api_keys.json
config/certs/
*.pem
*.key
*.crt
*.pfx

# ── Environment Configurations ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Runtime State & Persistent User Memory ────────────────────────────────────
memory/*.json
!memory/*.example.json
*.log
logs/

# ── Python Bytecode & Package Artifacts ───────────────────────────────────────
__pycache__/
*.py[cod]
*.class
*.egg-info/
.installed.cfg
*.egg
build/
dist/
*.spec

# ── Python Virtual Environments ───────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Model Weights & Large Binary Assets (Auto-downloaded on launch) ───────────
models/*.task
*.onnx
*.bin
*.pt
*.pth

# ── WhatsApp, Browser Sessions & Temporary Profiles ───────────────────────────
whatsapp_session/
browser_data/
session_data/
*.session
cookies.txt

# ── OS & Temporary Files ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.swp
*~
scratch/

# ── IDE & Editor Configuration ────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
